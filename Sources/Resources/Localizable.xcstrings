          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Perch"
          }
        }
      }
    },
    "menu.settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "menubar.accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch"
          }
        }
      }
    },
    "panel.empty.hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制点什么，或者把文件拖进来"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy something, or drag files in here"
          }
        }
      }
    },
    "panel.empty.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架是空的"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the shelf"
          }
        }
      }
    },
    "panel.header.paused": {
      "comment": "监听暂停时头部的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        }
      }
    },
    "panel.header.summary": {
      "comment": "面板头部统计：条数 · 文件数 · 占用。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板 %1$lld · 文件 %2$lld · %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld clips · %2$lld files · %3$@"
          }
        }
      }
    },
    "panel.header.title": {
      "comment": "面板头部左上角的名字。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch"
          }
        }
      }
    },
    "panel.pause": {
      "comment": "暂停按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停剪贴板监听"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause clipboard monitoring"
          }
        }
      }
    },
    "panel.resume": {
      "comment": "恢复按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复剪贴板监听"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
