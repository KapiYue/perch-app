        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list is empty — this rule is currently off"
          }
        }
      }
    },
    "settings.excluded.footer": {
      "comment": "来源 App 名单的脚注。刻意压到一行：只说做什么，不解释为什么。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 复制的内容不上架，内容本身不会被读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing copied in these apps reaches the shelf, and its content is never read."
          }
        }
      }
    },
    "settings.excluded.intro": {
      "comment": "名单编辑器顶部的说明。这里可以比设置页那行多说一点，因为是专门打开来看的。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 在前台时复制的任何内容都不会上架。移掉全部条目 = 关掉这条规则。\n另外，来源 App 主动标记为「别记录」的内容一律跳过，那条不需要设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While one of these apps is frontmost, anything copied is skipped entirely. Remove every entry to turn this rule off.\nSeparately, content a source app marks as do-not-record is always skipped — that needs no setting."
          }
        }
      }
    },
    "settings.excluded.label": {
      "comment": "来源 App 名单那一行的标题。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略这些 App 复制的内容"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore content copied from these apps"
          }
        }
      }
    },
    "settings.excluded.notInstalled": {
