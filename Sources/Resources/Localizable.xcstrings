{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "menubar.accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch"
          }
        }
      }
    },
    "hotzone.label": {
      "comment": "屏幕顶部黑条上的名字。只在没有刘海的屏幕上显示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch"
          }
        }
      }
    },
    "menu.open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Perch"
          }
        }
      }
    },
    "menu.settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "menu.quit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Perch"
          }
        }
      }
    },
    "panel.empty.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架是空的"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the shelf"
          }
        }
      }
    },
    "panel.empty.hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制点什么，或者把文件拖进来"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy something, or drag files in here"
          }
        }
      }
    },
    "settings.general": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "settings.placeholder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置项将在后续版本中逐步开放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings will be filled in as development continues."
          }
        }
      }
    },
    "clipboard.section": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        }
      }
    },
    "files.section": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
    "panel.header.title": {
      "comment": "面板头部左上角的名字。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch"
          }
        }
      }
    },
    "panel.header.summary": {
      "comment": "面板头部统计：条数 · 文件数 · 占用。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板 %1$lld · 文件 %2$lld · %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld clips · %2$lld files · %3$@"
          }
        }
      }
    },
    "panel.header.paused": {
      "comment": "监听暂停时头部的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        }
      }
    },
    "panel.pause": {
      "comment": "暂停按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停剪贴板监听"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause clipboard monitoring"
          }
        }
      }
    },
    "panel.resume": {
      "comment": "恢复按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复剪贴板监听"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume clipboard monitoring"
          }
        }
      }
    },
    "panel.settings": {
      "comment": "面板头部齿轮按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "clipboard.copied": {
      "comment": "单击整行取回后的行内反馈，约 1.1 秒。不要做成全局 toast。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ 已复制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ Copied"
          }
        }
      }
    },
    "row.pin": {
      "comment": "☆ 按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定（不自动清理）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin (never auto-cleared)"
          }
        }
      }
    },
    "row.unpin": {
      "comment": "★ 按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消固定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin"
          }
        }
      }
    },
    "row.remove": {
      "comment": "✕ 按钮的提示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "item.pinned": {
      "comment": "固定项在「多久前」后面显示这个，代替倒计时。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned"
          }
        }
      }
    },
    "item.meta.expires": {
      "comment": "行内副标题：%1$@ = 多久前，%2$@ = 剩余时长。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@后清理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · cleared in %2$@"
          }
        }
      }
    },
    "item.image.preview": {
      "comment": "图片条目的列表标题，%@ = 文件大小。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 图片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ image"
          }
        }
      }
    }
  }
}
