{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "alert.cancel": {
      "comment": "弹窗上的取消按钮。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "alert.ok": {
      "comment": "弹窗上那个唯一的按钮。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "clipboard.copied": {
      "comment": "单击整行取回后的行内反馈，约 1.1 秒。不要做成全局 toast。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ 已复制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ Copied"
          }
        }
      }
    },
    "clipboard.filter.empty": {
      "comment": "类型筛选把列表筛空时显示。不能什么都不画，否则用户会以为内容被清掉了。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个类型下暂时没有内容"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing of this type yet"
          }
        }
      }
    },
    "clipboard.limit.badge": {
      "comment": "剪贴板区贴着 200 条上限时，段标题上的琥珀色小标。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已满"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full"
          }
        }
      }
    },
    "clipboard.limit.help": {
      "comment": "「已满」小标的悬停提示。要说清「淘汰」和「按时长清理」是两条独立规则。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已满，新复制的内容会顶掉最旧的一条。固定的条目不会被顶掉。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full — anything you copy now evicts the oldest item. Pinned items are never evicted."
          }
        }
      }
    },
    "clipboard.section": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        }
      }
    },
    "files.action.deselect": {
      "comment": "批量操作条：取消选中。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      }
    },
    "files.action.deselect.help": {
      "comment": "取消选中的提示，带快捷键。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选中（Esc）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear selection (Esc)"
          }
        }
      }
    },
    "files.action.export": {
      "comment": "批量操作条：导出。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        }
      }
    },
    "files.action.export.help": {
      "comment": "导出既能点也能拖，两条路都要说出来。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击存到「下载」文件夹，或直接拖到任意位置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to save to Downloads, or drag it anywhere"
          }
        }
      }
    },
    "files.action.pin": {
      "comment": "批量操作条与右键菜单里的固定（短文案，行内 tooltip 用 row.pin）。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin"
          }
        }
      }
    },
    "files.action.remove": {
      "comment": "批量操作条与右键菜单里的移除。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "files.action.unpin": {
      "comment": "批量操作条与右键菜单里的取消固定。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消固定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin"
          }
        }
      }
    },
    "files.action.zip": {
      "comment": "批量操作条：打包 ZIP。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打包 ZIP"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP"
          }
        }
      }
    },
    "files.action.zip.help": {
      "comment": "打包同样既能点也能拖。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击压成一个 zip 存到「下载」，或直接拖出去"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to zip into Downloads, or drag the archive out"
          }
        }
      }
    },
    "files.airdrop.unavailable.detail": {
      "comment": "AirDrop 不可用时的弹窗正文。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认 Wi-Fi 和蓝牙都开着，附近也有能接收的设备。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Wi‑Fi and Bluetooth are on, and that a device nearby can receive."
          }
        }
      }
    },
    "files.airdrop.unavailable.title": {
      "comment": "AirDrop 不可用时的弹窗标题。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop 现在用不了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop isn’t available"
          }
        }
      }
    },
    "files.export.failed.title": {
      "comment": "导出失败的弹窗标题。详情用系统给的错误描述。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export failed"
          }
        }
      }
    },
    "files.menu.airdrop": {
      "comment": "右键菜单：AirDrop。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 AirDrop 发送"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send via AirDrop"
          }
        }
      }
    },
    "files.menu.copyPath": {
      "comment": "右键菜单：复制绝对路径。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制路径"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Path"
          }
        }
      }
    },
    "files.menu.count.suffix": {
      "comment": "菜单项后缀，只在选中多条时追加：%lld = 几条。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（%lld 项）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld items)"
          }
        }
      }
    },
    "files.menu.export": {
      "comment": "右键菜单：导出到下载文件夹。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出到「下载」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export to Downloads"
          }
        }
      }
    },
    "files.menu.open": {
      "comment": "右键菜单：用默认应用打开。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "files.menu.rename": {
      "comment": "右键菜单：改名，只在选中一条时出现。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename…"
          }
        }
      }
    },
    "files.menu.reveal": {
      "comment": "右键菜单：在访达里选中它。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "files.menu.zip": {
      "comment": "右键菜单：打包成 zip 放到下载文件夹。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打包 ZIP 并导出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export as ZIP"
          }
        }
      }
    },
    "files.rename.confirm": {
      "comment": "改名弹窗的确认按钮。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        }
      }
    },
    "files.rename.detail": {
      "comment": "改名弹窗的说明：改的是架上这份副本。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改的是架上这份副本的文件名，拖出去之后就是这个名字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This renames the copy on the shelf — it’s the name the file lands with when you drag it out."
          }
        }
      }
    },
    "files.rename.title": {
      "comment": "改名弹窗的标题。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        }
      }
    },
    "files.section": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
    "files.selectAll": {
      "comment": "文件区段标题上的「□ 全选」。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全选"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select All"
          }
        }
      }
    },
    "files.selectAll.help": {
      "comment": "「全选」的提示，带快捷键。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全选文件（⌘A）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all files (⌘A)"
          }
        }
      }
    },
    "files.selected": {
      "comment": "批量操作条左侧：%lld = 选中了几个。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %lld 个"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selected"
          }
        }
      }
    },
    "files.zip.name": {
      "comment": "多选打包时 zip 的名字，也是解压出来那层文件夹的名字：%lld = 几个文件。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架 %lld 项"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch %lld items"
          }
        }
      }
    },
    "filter.all": {
      "comment": "剪贴板类型筛选 pill。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      }
    },
    "filter.code": {
      "comment": "剪贴板类型筛选 pill。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        }
      }
    },
    "filter.image": {
      "comment": "剪贴板类型筛选 pill。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images"
          }
        }
      }
    },
    "filter.link": {
      "comment": "剪贴板类型筛选 pill。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links"
          }
        }
      }
    },
    "filter.text": {
      "comment": "剪贴板类型筛选 pill。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        }
      }
    },
    "hotzone.label": {
      "comment": "屏幕顶部黑条上的名字。只在没有刘海的屏幕上显示。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch"
          }
        }
      }
    },
    "item.image.preview": {
      "comment": "图片条目的列表标题，%@ = 文件大小。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 图片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ image"
          }
        }
      }
    },
    "item.meta.expires": {
      "comment": "行内副标题：%1$@ = 多久前，%2$@ = 剩余时长。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@后清理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · cleared in %2$@"
          }
        }
      }
    },
    "item.pinned": {
      "comment": "固定项在「多久前」后面显示这个，代替倒计时。",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned"
          }
        }
      }
    },
    "menu.open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开栖架"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Perch"
          }
        }
      }
    },
    "menu.quit": {
